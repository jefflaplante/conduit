.beads
.claude
.github
bin
coverage.*
*.db
*.db-*
*.sqlite*
*.env
.env
config.json
config.live.json
workspace
logs
*.log
.worktrees
PRIVATE
tmp
.secrets
*.secrets
config.*.json
config.local*.json
*.bak
*.bak-*
*.db.backup.*
*.db.pre-*
conduit-backup-*.tar.gz
*.pem
*.key
id_rsa*
id_ecdsa*
id_ed25519*
credentials.json
token.json
client_secret*.json
leak-denylist*
