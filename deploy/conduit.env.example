# Secrets for deploy/compose.yaml. Copy to deploy/conduit.env (gitignored by
# the *.env rule) and chmod 600. Values are passed to the container as
# environment variables and expanded into ${VAR} placeholders in the config.

# Required by the image's default config (configs/container/conduit.json).
ANTHROPIC_API_KEY=

# Optional: pin the token-signing secret instead of the one generated on
# first start at /data/auth/token_secret.
# CONDUIT_TOKEN_SECRET=

# Referenced by your own config, if you mount one:
# TELEGRAM_BOT_TOKEN=
# BRAVE_API_KEY=
