[Unit]
Description=Conduit Gateway
Documentation=https://github.com/jefflaplante/conduit
After=network-online.target
Wants=network-online.target
# Start-rate limits are [Unit] settings; systemd ignores them in [Service].
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=conduit
Group=conduit
# Files the gateway creates (SQLite DB/-wal/-shm, key files, logs) are owner-only.
UMask=0077
WorkingDirectory=/home/conduit/conduit

# Binary and config
ExecStart=/home/conduit/conduit/bin/conduit server --config /home/conduit/conduit/config.json

# Environment
Environment=PATH=/usr/local/go/bin:/usr/bin:/bin:/usr/local/bin
EnvironmentFile=-/home/conduit/.conduit-secrets.env

# Graceful shutdown: SIGTERM drains in-flight turns (<=15s), then stops
# subsystems (<=10s); the gateway force-exits itself at 27s, under
# TimeoutStopSec. A second SIGTERM/SIGINT forces immediate exit.
# Keep TimeoutStopSec > 27s if you change it (conduit-31jg.27).
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy — always so clean drain-exits (SIGHUP reload, gateway tool
# restart) also bring us back; on-failure lets clean exits leave the service dead.
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/conduit/conduit/
PrivateTmp=true
# PID file: systemd creates /run/conduit (owned by User=, writable despite
# ProtectSystem=strict, removed on stop) and sets $RUNTIME_DIRECTORY, so the
# gateway writes /run/conduit/conduit.pid. The CLI (stop/status/restart,
# backup restore) finds it there without --pidfile; PrivateTmp hides /tmp.
# (conduit-1qcg)
RuntimeDirectory=conduit
RuntimeDirectoryMode=0755

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=conduit

[Install]
WantedBy=multi-user.target
