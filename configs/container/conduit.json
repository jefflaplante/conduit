{
  "port": 18789,
  "data_dir": "/data",
  "database": {
    "path": "/data/gateway.db"
  },
  "ai": {
    "default_provider": "anthropic",
    "providers": [
      {
        "name": "anthropic",
        "type": "anthropic",
        "api_key": "${ANTHROPIC_API_KEY}",
        "model": "claude-sonnet-4-6"
      }
    ]
  },
  "workspace": {
    "context_dir": "/workspace"
  },
  "tools": {
    "enabled_tools": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Find",
      "MemorySearch",
      "Context",
      "WebFetch"
    ],
    "max_tool_chains": 25,
    "sandbox": {
      "workspace_dir": "/workspace",
      "allowed_paths": [
        "/workspace",
        "/tmp"
      ]
    }
  },
  "channels": []
}
